# Copy this file to .env, fill in your real Supabase project values,
# and never commit the real .env (it's already in .gitignore).
#
# Get these from: Supabase Dashboard -> your project -> Settings -> API
#   Project URL     -> VITE_SUPABASE_URL
#   anon public key -> VITE_SUPABASE_ANON_KEY
# Both are safe to ship inside the app — the anon key only works within
# whatever Row Level Security policies are defined in supabase/schema.sql.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: force preview mode even when the two values above are filled in.
# Runs the whole app on local sample data (src/data/demoData.js) and makes
# zero network calls — useful for reviewing the UI without touching real data.
# VITE_PREVIEW=1
